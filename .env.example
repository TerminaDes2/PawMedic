# Local Supabase values. Copy this file to .env; never commit .env.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-the-value-from-supabase-status

# Used only by Supabase CLI/Edge Function local configuration. Do not expose
# this value to Android or desktop clients.
SUPABASE_SERVICE_ROLE_KEY=replace-with-the-local-service-role-key

# Optional client configuration when the real Supabase adapter is wired.
PAWMEDIC_ENV=local
